# Copy to .env. Portfolio/demo mode makes no external requests.
DATA_ROOT=data
LOG_LEVEL=INFO
OSINT_MODE=sim

XGB_WEIGHT=0.45
IFOREST_WEIGHT=0.25
SQL_WEIGHT=0.20
GRAPH_WEIGHT=0.10
MAX_CASE_QUEUE=25
PRECISION_TARGET=0.80

# Required only when OSINT_MODE=live.
IDENTITY_API_URL=https://vendor.example/v1/identity
IDENTITY_API_KEY=
DEVICE_API_URL=https://vendor.example/v1/device
DEVICE_API_KEY=
ADDRESS_API_URL=https://vendor.example/v1/address
ADDRESS_API_KEY=
